# 服务器上那台 nginx 的配置示例（不是前端容器里的那份）。
#
# 放到 /etc/nginx/conf.d/artifex.conf（用面板管理 nginx 的，按面板的站点目录放，
# 或在面板里加一个反向代理站点，目标 http://127.0.0.1:18082），然后 nginx -t && nginx -s reload。
# 把 artifex.example.com 换成真实域名；没有域名先用 server_name _; 按 IP 访问。

server {
    listen 80;
    server_name artifex.example.com;

    location / {
        proxy_pass http://127.0.0.1:18082;   # 前端容器
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }
}

# 只需要暴露前端这一个入口：/v1 由前端容器内的 nginx 反代到后端（见 nginx.conf）。
# HTTPS：有域名后用 certbot --nginx -d artifex.example.com 一键签发并改成 443。
